# Copy to .env — `npm start` loads it automatically (node --env-file-if-exists).

# Port to listen on.
PORT=3000

# Public API documentation at /docs, /openapi.yaml and /docs/reference.md.
# On unless explicitly disabled; false / 0 / off / no all turn it off.
DOCS_ENABLED=true

# Override every cache TTL (milliseconds). Unset uses the per-kind defaults:
# leagues 24h, teams 1h, squad 1h, player 6h, aggregate 6h.
# CACHE_TTL_MS=3600000
